PORT=3000
CORS_ORIGIN=https://ornek-site.com
DATABASE_URL=postgresql://kullanici:sifre@host:5432/postgres
JWT_SECRET=uzun-rastgele-bir-metin
NODE_ENV=production
# Hesap şifreleri: tanımlıysa sunucu açılışta bu şifreyi uygular; boşsa DB'deki şifre korunur.
KANTAR_AVDAN_PASSWORD=
KANTAR_1OSB_PASSWORD=
# Selahattin Toker (kullanıcı adı: xxr)
XXR_PASSWORD=
# Şaban (piyasa amiri, kullanıcı adı: saban)
AMIR_PASSWORD=
# Uğur Aktaş (kullanıcı adı: ugur) ayrı şifre kullanır.
UGUR_PASSWORD=
# Cloudflare origin doğrulama. Başlık: x-origin-verify
# Sıra: kod off ile yayınlanır, Cloudflare kuralı başlığı ekler, log izlenir, sonra enforce.
# off (varsayılan) | log (eksik/yanlış başlığı yazar, engellemez) | enforce (403)
# ORIGIN_VERIFY_MODE=off
# ORIGIN_VERIFY_SECRET en az 32 bayt rastgele olmalı. Değeri buraya yazmayın.
# Kantar PC Excel Ajanı. Boş bırakılırsa anahtar JWT_SECRET üzerinden türetilir.
# Doluysa (en az 16 karakter) bu değer kullanılır. Kantar, siteden "Ajanı kur" ile indirir.
EXCEL_AGENT_KEY_AVDAN=
EXCEL_AGENT_KEY_1OSB=
