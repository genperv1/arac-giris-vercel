PORT=3000
CORS_ORIGIN=https://ornek-site.com
DATABASE_URL=postgresql://kullanici:sifre@host:5432/postgres
JWT_SECRET=uzun-rastgele-bir-metin
NODE_ENV=production
# Hesap şifreleri: tanımlıysa sunucu açılışta bu şifreyi uygular; boşsa DB'deki şifre korunur.
KANTAR_AVDAN_PASSWORD=
KANTAR_1OSB_PASSWORD=
AMIR_PASSWORD=
# Şaban (piyasa amiri, kullanıcı adı: saban) aynı AMIR_PASSWORD ile açılır.
# Kantar PC Excel Ajanı. Boş bırakılırsa anahtar JWT_SECRET üzerinden türetilir.
# Doluysa (en az 16 karakter) bu değer kullanılır. Kantar, siteden "Ajanı kur" ile indirir.
EXCEL_AGENT_KEY_AVDAN=
EXCEL_AGENT_KEY_1OSB=
